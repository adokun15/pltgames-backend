{
  "name": "pltgames-backend",
  "version": "1.0.0",
  "description": "Pltgame backend",
  "license": "ISC",
  "author": "Ohida",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx --watch --env-file .env.local src/index.ts",
    "dev:staging": "tsx --watch --env-file .env.staging src/index.ts",
    "dev:prod": "tsx --watch --env-file .env.production src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc",
    "type-checker": "tsx --noEmit",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "express-validator": "^7.3.2",
    "jsonwebtoken": "^9.0.3",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "winston": "^3.19.0",
    "winston-discord-transport": "^1.3.0"
  },
  "devDependencies": {
    "@tsconfig/node22": "^22.0.5",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "pg": "^8.22.0",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
